# SolveSphere Environment Variables

# Environment & Server
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="SolveSphere"
API_V1_STR="/api/v1"
SECRET_KEY="solvesphere-secret-key-change-in-production-min-32-chars-long"

# Database Configuration
# Set DATABASE_URL for PostgreSQL with pgvector, or fallback to SQLite for local development
DATABASE_URL="sqlite+aiosqlite:///./solvesphere.db"
SYNC_DATABASE_URL="sqlite:///./solvesphere.db"
DB_ENGINE="sqlite" # "postgresql" or "sqlite"

# Redis & Background Tasks
REDIS_URL="redis://localhost:6379/0"

# Authentication & Security
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM="HS256"
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Rate Limiting
RATE_LIMIT_LOGIN="5/minute"
RATE_LIMIT_CHALLENGE="10/hour"
RATE_LIMIT_AI="20/minute"

# File Upload Configuration
MAX_IMAGE_SIZE_MB=5
MAX_PDF_SIZE_MB=10
MAX_VIDEO_SIZE_MB=50
UPLOAD_DIR="./storage/uploads"

# AI Pipeline Configuration
AI_EMBEDDING_MODEL="all-MiniLM-L6-v2"
AI_DUPLICATE_SIMILARITY_THRESHOLD=0.88
AI_REVIEW_SIMILARITY_THRESHOLD=0.78
OPENAI_API_KEY="" # Optional hosted LLM key
